# ==========================================
# ForwardCheck AI - Environment Configuration
# ==========================================

# Server Environment
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
ENVIRONMENT=development

# Database Configuration (SQLite by default for zero-config local run; PostgreSQL in production)
DATABASE_URL=sqlite:///./forwardcheck.db
# DATABASE_URL=postgresql://user:password@localhost:5432/forwardcheck

# Optional AI Providers (leave blank to run in honest sample/local heuristic mode)
# Google Gemini API key for claim decomposition & multilingual explanation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Search & Fact-Checking Providers
# Tavily API key for web search and live verification
TAVILY_API_KEY=
# Brave Search API Key
BRAVE_SEARCH_API_KEY=
# Google Fact Check Tools API Key
GOOGLE_FACTCHECK_API_KEY=

# Application URL (for CORS and share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Security & Sessions
SECRET_KEY=dev-secret-key-change-in-production-32bytesmin
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
